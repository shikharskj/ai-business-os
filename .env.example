# Local development PostgreSQL. Production host is Neon (see Architecture Decisions / spec 30).
# Do not commit real secrets.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_business_os"

# Clerk — publishable key is public; secret and webhook signing secret are server-only.
# Prefer real Dashboard / `npx clerk@latest init` values. Empty keys allow Clerk keyless in local dev.
# Do not use fake pk_test_/sk_test_ placeholders; Clerk rejects them and auth() then fails.
# Clerk Organizations are enabled for the workspace boundary (Business mapping is spec 04).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/app"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/app"

# Object storage. Production is Cloudflare R2 (S3-compatible). Local/filesystem
# is allowed only in development/test when STORAGE_DRIVER=local (or omitted).
# Production must use STORAGE_DRIVER=r2 with the R2 credentials below; missing
# R2 config fails adapter initialization and never falls back to local storage.
STORAGE_DRIVER="local"
LOCAL_STORAGE_ROOT=".data/storage"
# STORAGE_MAX_BYTES="10485760"
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET=
# CLOUDFLARE_R2_ENDPOINT=

# Accepted production vendors (wire remaining adapters in later specs; do not invent alternatives):
# - PostgreSQL: Neon
# - Object storage: Cloudflare R2
# - AI: OpenAI behind lib/ai adapter
