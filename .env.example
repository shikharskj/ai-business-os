# Local development PostgreSQL. Production host is Neon (see Architecture Decisions / spec 30).
# Do not commit real secrets.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_business_os"

# Clerk — publishable key is public; secret and webhook signing secret are server-only.
# Prefer real Dashboard / `npx clerk@latest init` values. Empty keys allow Clerk keyless in local dev.
# Do not use fake pk_test_/sk_test_ placeholders; Clerk rejects them and auth() then fails.
# Clerk Organizations are enabled for the workspace boundary (Business mapping is spec 04).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/app"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/app"

# Accepted production vendors (wire in later specs; do not invent alternatives):
# - PostgreSQL: Neon
# - Object storage: Cloudflare R2
# - AI: OpenAI behind lib/ai adapter
