generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  clerkUserId String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownedBusinesses     Business[]   @relation("BusinessOwner")
  memberships         Membership[]
  uploadedDocuments   Document[]   @relation("DocumentUploader")

  @@map("users")
}

enum BusinessType {
  PROPRIETORSHIP
  PARTNERSHIP
  PRIVATE_LIMITED
  LLP
  OTHER
}

enum GstRegistrationStatus {
  NOT_REGISTERED
  REGISTERED
  COMPOSITION
}

enum MembershipRole {
  OWNER
  ADMIN
  STAFF
  ACCOUNTANT
}

enum MembershipStatus {
  ACTIVE
  REVOKED
}

model Business {
  id                    String                @id @default(uuid())
  clerkOrganizationId   String                @unique
  name                  String
  type                  BusinessType
  ownerUserId           String
  addressLine1          String
  addressLine2          String?
  city                  String
  state                 String
  postalCode            String
  country               String                @default("IN")
  phone                 String
  email                 String
  gstRegistrationStatus GstRegistrationStatus
  gstin                 String?
  financialYearStartMonth Int
  timezone              String                @default("Asia/Kolkata")
  currency              String                @default("INR")
  defaultGstRateBps     Int                   @default(1800)
  lowStockThreshold     Decimal               @default(5.0000) @db.Decimal(18, 4)
  logoDocumentId        String?
  closedThroughPeriodKey String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  owner       User         @relation("BusinessOwner", fields: [ownerUserId], references: [id])
  memberships Membership[]
  auditRecords AuditRecord[]
  outboxEvents OutboxEvent[]
  taxRates     TaxRate[]
  hsnSacCodes  HsnSacCode[]
  accounts     Account[]
  journals     Journal[]
  documents    Document[]
  parties      Party[]
  products     Product[]
  inventoryMovements InventoryMovement[]
  quotations   Quotation[]
  quotationLines QuotationLine[]
  quotationNumberSeries QuotationNumberSeries[]
  salesOrders SalesOrder[]
  salesOrderLines SalesOrderLine[]
  salesOrderNumberSeries SalesOrderNumberSeries[]
  salesInvoices SalesInvoice[]
  salesInvoiceLines SalesInvoiceLine[]
  invoiceNumberSeries InvoiceNumberSeries[]
  creditNotes CreditNote[]
  creditNoteLines CreditNoteLine[]
  creditNoteNumberSeries CreditNoteNumberSeries[]
  customerPayments CustomerPayment[]
  customerPaymentAllocations CustomerPaymentAllocation[]
  customerPaymentNumberSeries CustomerPaymentNumberSeries[]
  supplierPayments SupplierPayment[]
  supplierPaymentAllocations SupplierPaymentAllocation[]
  supplierPaymentNumberSeries SupplierPaymentNumberSeries[]
  expenses Expense[]
  expenseNumberSeries ExpenseNumberSeries[]
  purchases Purchase[]
  purchaseLines PurchaseLine[]
  purchaseNumberSeries PurchaseNumberSeries[]
  purchaseReturns PurchaseReturn[]
  purchaseReturnLines PurchaseReturnLine[]
  purchaseReturnNumberSeries PurchaseReturnNumberSeries[]
  listRowOrders ListRowOrder[]
  notifications Notification[]
  businessStateMeta BusinessStateMeta?
  receivablesRiskState ReceivablesRiskState?
  inventoryRiskState InventoryRiskState?
  salesMomentumState SalesMomentumState?
  cashPositionState CashPositionState?
  attentionItems AttentionItem[]
  automationOutcomes AutomationOutcome[]
  autonomyPolicy TenantAutonomyPolicy?
  workflowRuns WorkflowRun[]

  @@map("businesses")
}

/// Per-tenant L0–L4 autonomy configuration. Missing row = L4 off (empty allow-list).
model TenantAutonomyPolicy {
  tenantId                 String   @id
  allowedActionClasses     String[] @default([])
  amountThresholds         Json     @default("{}")
  requireConfirmationAbove Json     @default("{}")
  disabledAutomations      String[] @default([])
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_autonomy_policies")
}

model ListRowOrder {
  id        String   @id @default(uuid())
  tenantId  String
  listKey   String
  recordId  String
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, listKey, recordId])
  @@index([tenantId, listKey, sortOrder])
  @@map("list_row_orders")
}

model Membership {
  id                            String           @id @default(uuid())
  userId                        String
  tenantId                      String
  role                          MembershipRole
  status                        MembershipStatus @default(ACTIVE)
  clerkOrganizationMembershipId String?          @unique
  createdAt                     DateTime         @default(now())
  updatedAt                     DateTime         @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@map("memberships")
}

model AuditRecord {
  id            String   @id @default(uuid())
  tenantId      String
  actorUserId   String
  action        String
  resource      String
  resourceId    String
  metadata      Json     @default("{}")
  correlationId String?
  createdAt     DateTime @default(now())

  business Business @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, resource, resourceId])
  @@index([tenantId, createdAt])
  @@map("audit_records")
}

model OutboxEvent {
  id            String   @id @default(uuid())
  tenantId      String
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  correlationId String?
  /** Legacy global cursor; prefer OutboxConsumerReceipt per consumer. */
  processedAt   DateTime?
  createdAt     DateTime @default(now())

  business  Business               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receipts  OutboxConsumerReceipt[]

  @@index([processedAt, createdAt])
  @@index([tenantId, eventType])
  @@index([createdAt])
  @@map("outbox_events")
}

/// Per-consumer processing receipt for transactional outbox fan-out.
/// Absence of a row means the consumer has not successfully handled the event.
model OutboxConsumerReceipt {
  id           String   @id @default(uuid())
  eventId      String
  consumerName String
  processedAt  DateTime @default(now())

  event OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, consumerName])
  @@index([consumerName, processedAt])
  @@map("outbox_consumer_receipts")
}

/// Projection envelope / schema version for BusinessState families (R1).
model BusinessStateMeta {
  tenantId      String   @id
  schemaVersion Int      @default(1)
  rebuiltAt     DateTime?
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("business_state_meta")
}

/// Derived receivables risk summary — rebuildable from invoices + allocations.
model ReceivablesRiskState {
  tenantId              String   @id
  openInvoiceCount      Int
  overdueInvoiceCount   Int
  totalOutstanding      Decimal  @db.Decimal(18, 2)
  overdueOutstanding    Decimal  @db.Decimal(18, 2)
  currency              String   @default("INR")
  computedAt            DateTime
  updatedAt             DateTime @updatedAt

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("receivables_risk_state")
}

/// Derived inventory / low-stock risk summary — rebuildable from stock movements.
model InventoryRiskState {
  tenantId       String   @id
  lowStockCount  Int
  thresholdMajor String
  computedAt     DateTime
  updatedAt      DateTime @updatedAt

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("inventory_risk_state")
}

/// Derived sales momentum for a rolling window — rebuildable from posted invoices.
/// Formula: sum of posted invoice grand totals (and taxable) in [windowFrom, windowTo].
model SalesMomentumState {
  tenantId            String   @id
  windowDays          Int
  windowFrom          String
  windowTo            String
  postedInvoiceCount  Int
  salesTotal          Decimal  @db.Decimal(18, 2)
  taxableTotal        Decimal  @db.Decimal(18, 2)
  currency            String   @default("INR")
  computedAt          DateTime
  updatedAt           DateTime @updatedAt

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("sales_momentum_state")
}

/// Derived cash position — ledger balances of designated cash/bank COA accounts.
/// Never unpaid invoices. Rebuildable from journals.
model CashPositionState {
  tenantId        String   @id
  cashBalance     Decimal  @db.Decimal(18, 2)
  bankBalance     Decimal  @db.Decimal(18, 2)
  total           Decimal  @db.Decimal(18, 2)
  currency        String   @default("INR")
  scale           Int      @default(2)
  cashAccountName String   @default("Cash")
  bankAccountName String   @default("Bank")
  computedAt      DateTime
  updatedAt       DateTime @updatedAt

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("cash_position_state")
}

/// Derived Needs-attention queue row. Rebuildable from overdue invoices,
/// low-stock products, and idle quotations. Dismiss does not mutate source records.
model AttentionItem {
  id                String    @id @default(uuid())
  tenantId          String
  naturalKey        String
  type              String
  severity          Int
  status            String    @default("OPEN")
  title             String
  body              String
  href              String
  resourceType      String
  resourceId        String
  amount            Decimal?  @db.Decimal(18, 2)
  currency          String?
  factId            String?
  computedAt        DateTime
  dismissedAt       DateTime?
  dismissedByUserId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  business Business             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outcomes AutomationOutcome[]

  @@unique([tenantId, naturalKey])
  @@index([tenantId, status, severity])
  @@map("attention_items")
}

/// Outcome hook for dismissals and later automation learning (reminder sent, paid after reminder).
model AutomationOutcome {
  id              String   @id @default(uuid())
  tenantId        String
  kind            String
  attentionItemId String?
  resourceType    String?
  resourceId      String?
  payload         Json     @default("{}")
  idempotencyKey  String
  recordedAt      DateTime @default(now())

  business      Business       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attentionItem AttentionItem? @relation(fields: [attentionItemId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, kind, recordedAt])
  @@index([tenantId, resourceType, resourceId])
  @@map("automation_outcomes")
}

/// Automation runtime job row. The runner never posts journals or stock.
model WorkflowRun {
  id               String    @id @default(uuid())
  tenantId         String
  workflowId       String
  triggerEventId   String
  triggerEventType String
  aggregateType    String
  aggregateId      String
  triggerPayload   Json      @default("{}")
  idempotencyKey   String
  concurrencyKey   String
  status           String
  currentStep      String    @default("EVENT")
  attemptCount     Int       @default(0)
  maxAttempts      Int       @default(5)
  nextAttemptAt    DateTime  @default(now())
  lastError        String?
  result           Json      @default("{}")
  outcomeKind      String?
  correlationId    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  startedAt        DateTime?
  completedAt      DateTime?

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([status, nextAttemptAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, concurrencyKey, status])
  @@map("workflow_runs")
}

model Notification {
  id             String    @id @default(uuid())
  tenantId       String
  channel        String    @default("IN_APP")
  type           String
  title          String
  body           String
  href           String?
  resourceType   String?
  resourceId     String?
  idempotencyKey String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([tenantId, readAt])
  @@map("notifications")
}

model TaxRate {
  id            String    @id @default(uuid())
  tenantId      String
  name          String
  rateBps       Int
  isDefault     Boolean   @default(false)
  effectiveFrom String
  effectiveTo   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isDefault])
  @@index([tenantId, effectiveFrom])
  @@map("tax_rates")
}

model HsnSacCode {
  id            String   @id @default(uuid())
  tenantId      String
  code          String
  description   String
  kind          String
  taxRateBps    Int
  effectiveFrom String
  effectiveTo   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, code])
  @@index([tenantId, effectiveFrom])
  @@map("hsn_sac_codes")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

model Account {
  id            String        @id @default(uuid())
  tenantId      String
  code          String
  name          String
  type          AccountType
  normalBalance NormalBalance
  createdAt     DateTime      @default(now())

  business Business     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines    JournalLine[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("accounts")
}

model Journal {
  id                   String   @id @default(uuid())
  tenantId             String
  accountingDate       String
  periodKey            String
  financialYearKey     String
  sourceType           String
  sourceId             String
  memo                 String?
  reversalOfJournalId  String?
  postedAt             DateTime @default(now())

  business Business     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines    JournalLine[]
  salesInvoices SalesInvoice[]
  customerPayments CustomerPayment[]
  supplierPayments SupplierPayment[]
  expenses Expense[]
  purchases Purchase[]
  creditNotes CreditNote[]
  purchaseReturns PurchaseReturn[]

  @@unique([id, tenantId])
  @@unique([tenantId, reversalOfJournalId])
  @@index([tenantId, periodKey])
  @@index([tenantId, sourceType, sourceId])
  @@map("journals")
}

model JournalLine {
  id          String  @id @default(uuid())
  tenantId    String
  journalId   String
  accountId   String
  description String?
  debit       Decimal @db.Decimal(18, 2)
  credit      Decimal @db.Decimal(18, 2)

  journal Journal @relation(fields: [journalId, tenantId], references: [id, tenantId], onDelete: Cascade)
  account Account @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, accountId])
  @@index([journalId])
  @@map("journal_lines")
}

model Document {
  id                 String   @id @default(uuid())
  tenantId           String
  ownerRecordType    String
  ownerRecordId      String
  filename           String
  contentType        String
  sizeBytes          Int
  storageKey         String   @unique
  uploadedByUserId   String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business   Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation("DocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, ownerRecordType, ownerRecordId])
  @@index([tenantId, createdAt])
  @@map("documents")
}

enum PartyKind {
  CUSTOMER
  SUPPLIER
}

enum PartyStatus {
  ACTIVE
  INACTIVE
}

model Party {
  id                    String                @id @default(uuid())
  tenantId              String
  kind                  PartyKind
  name                  String
  phone                 String?
  email                 String?
  billingAddressLine1   String?
  billingAddressLine2   String?
  city                  String?
  state                 String?
  postalCode            String?
  country               String                @default("IN")
  gstRegistrationStatus GstRegistrationStatus @default(NOT_REGISTERED)
  gstin                 String?
  status                PartyStatus           @default(ACTIVE)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  business    Business     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotations  Quotation[]
  salesOrders SalesOrder[]
  salesInvoices SalesInvoice[]
  customerPayments CustomerPayment[]
  supplierPayments SupplierPayment[]
  purchases Purchase[]
  creditNotes CreditNote[]
  purchaseReturns PurchaseReturn[]

  @@unique([id, tenantId])
  @@index([tenantId, kind, status])
  @@index([tenantId, name])
  @@map("parties")
}

enum ProductKind {
  PRODUCT
  SERVICE
}

model Product {
  id               String      @id @default(uuid())
  tenantId         String
  kind             ProductKind
  name             String
  sku              String
  unitOfMeasurement String
  sellingPrice     Decimal     @db.Decimal(18, 2)
  purchasePrice    Decimal     @db.Decimal(18, 2)
  hsnSac           String?
  taxRateBps       Int
  category         String?
  tracksInventory  Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  business        Business             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements       InventoryMovement[]
  quotationLines  QuotationLine[]
  salesOrderLines SalesOrderLine[]
  salesInvoiceLines SalesInvoiceLine[]
  purchaseLines   PurchaseLine[]
  creditNoteLines CreditNoteLine[]
  purchaseReturnLines PurchaseReturnLine[]

  @@unique([id, tenantId])
  @@unique([tenantId, sku])
  @@index([tenantId, kind])
  @@index([tenantId, name])
  @@map("products")
}

enum InventoryMovementCause {
  OPENING
  ADJUSTMENT
  SALE
  PURCHASE
  RETURN
}

enum InventoryMovementDirection {
  IN
  OUT
}

model InventoryMovement {
  id             String                      @id @default(uuid())
  tenantId       String
  productId      String
  cause          InventoryMovementCause
  direction      InventoryMovementDirection
  quantity       Decimal                     @db.Decimal(18, 4)
  occurredOn     String
  sourceType     String
  sourceId       String
  idempotencyKey String
  reason         String?
  actorUserId    String
  createdAt      DateTime                    @default(now())

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, productId, occurredOn])
  @@index([tenantId, cause])
  @@map("inventory_movements")
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  CANCELLED
  CONVERTED
}

model Quotation {
  id                       String          @id @default(uuid())
  tenantId                 String
  number                   String
  customerId               String
  customerName             String
  status                   QuotationStatus @default(DRAFT)
  issuedOn                 String
  validUntil               String?
  notes                    String?
  placeOfSupplyStateCode   String
  subtotal                 Decimal         @db.Decimal(18, 2)
  discountTotal            Decimal         @db.Decimal(18, 2)
  taxableAmount            Decimal         @db.Decimal(18, 2)
  cgst                     Decimal         @db.Decimal(18, 2)
  sgst                     Decimal         @db.Decimal(18, 2)
  igst                     Decimal         @db.Decimal(18, 2)
  totalTax                 Decimal         @db.Decimal(18, 2)
  grandTotal               Decimal         @db.Decimal(18, 2)
  supplyType               String
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  business Business       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Party          @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  lines    QuotationLine[]
  invoice  SalesInvoice?
  salesOrder SalesOrder?

  @@unique([id, tenantId])
  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, issuedOn])
  @@map("quotations")
}

model QuotationLine {
  id                 String  @id @default(uuid())
  tenantId           String
  quotationId        String
  sortOrder          Int
  productId          String
  productName        String
  sku                String
  unitOfMeasurement  String
  hsnSac             String?
  taxRateBps         Int
  quantity           Decimal @db.Decimal(18, 4)
  unitPrice          Decimal @db.Decimal(18, 2)
  discount           Decimal @db.Decimal(18, 2)
  lineSubtotal       Decimal @db.Decimal(18, 2)
  taxableAmount      Decimal @db.Decimal(18, 2)
  cgst               Decimal @db.Decimal(18, 2)
  sgst               Decimal @db.Decimal(18, 2)
  igst               Decimal @db.Decimal(18, 2)
  totalTax           Decimal @db.Decimal(18, 2)
  lineTotal          Decimal @db.Decimal(18, 2)
  supplyType         String
  treatment          String

  quotation Quotation @relation(fields: [quotationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  product   Product   @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)
  business  Business  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId, quotationId])
  @@index([quotationId, sortOrder])
  @@map("quotation_lines")
}

model QuotationNumberSeries {
  id                String @id @default(uuid())
  tenantId          String
  financialYearKey  String
  lastNumber        Int

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, financialYearKey])
  @@map("quotation_number_series")
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
  FULFILLED
}

model SalesOrder {
  id                       String           @id @default(uuid())
  tenantId                 String
  number                   String
  customerId               String
  customerName             String
  status                   SalesOrderStatus @default(DRAFT)
  quotationId              String?
  issuedOn                 String
  expectedOn               String?
  notes                    String?
  placeOfSupplyStateCode   String
  subtotal                 Decimal          @db.Decimal(18, 2)
  discountTotal            Decimal          @db.Decimal(18, 2)
  taxableAmount            Decimal          @db.Decimal(18, 2)
  cgst                     Decimal          @db.Decimal(18, 2)
  sgst                     Decimal          @db.Decimal(18, 2)
  igst                     Decimal          @db.Decimal(18, 2)
  totalTax                 Decimal          @db.Decimal(18, 2)
  grandTotal               Decimal          @db.Decimal(18, 2)
  supplyType               String
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  business  Business        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Party           @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  quotation Quotation?      @relation(fields: [quotationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  lines     SalesOrderLine[]
  invoice   SalesInvoice?

  @@unique([id, tenantId])
  @@unique([tenantId, number])
  @@unique([quotationId, tenantId])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, issuedOn])
  @@map("sales_orders")
}

model SalesOrderLine {
  id                 String  @id @default(uuid())
  tenantId           String
  salesOrderId       String
  sortOrder          Int
  productId          String
  productName        String
  sku                String
  unitOfMeasurement  String
  hsnSac             String?
  taxRateBps         Int
  quantity           Decimal @db.Decimal(18, 4)
  unitPrice          Decimal @db.Decimal(18, 2)
  discount           Decimal @db.Decimal(18, 2)
  lineSubtotal       Decimal @db.Decimal(18, 2)
  taxableAmount      Decimal @db.Decimal(18, 2)
  cgst               Decimal @db.Decimal(18, 2)
  sgst               Decimal @db.Decimal(18, 2)
  igst               Decimal @db.Decimal(18, 2)
  totalTax           Decimal @db.Decimal(18, 2)
  lineTotal          Decimal @db.Decimal(18, 2)
  supplyType         String
  treatment          String

  salesOrder SalesOrder @relation(fields: [salesOrderId, tenantId], references: [id, tenantId], onDelete: Cascade)
  product    Product    @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)
  business   Business   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId, salesOrderId])
  @@index([salesOrderId, sortOrder])
  @@map("sales_order_lines")
}

model SalesOrderNumberSeries {
  id               String @id @default(uuid())
  tenantId         String
  financialYearKey String
  lastNumber       Int

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, financialYearKey])
  @@map("sales_order_number_series")
}

enum SalesInvoiceStatus {
