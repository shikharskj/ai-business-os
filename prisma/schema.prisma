generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  clerkUserId String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownedBusinesses     Business[]   @relation("BusinessOwner")
  memberships         Membership[]
  uploadedDocuments   Document[]   @relation("DocumentUploader")

  @@map("users")
}

enum BusinessType {
  PROPRIETORSHIP
  PARTNERSHIP
  PRIVATE_LIMITED
  LLP
  OTHER
}

enum GstRegistrationStatus {
  NOT_REGISTERED
  REGISTERED
  COMPOSITION
}

enum MembershipRole {
  OWNER
  ADMIN
  STAFF
  ACCOUNTANT
}

enum MembershipStatus {
  ACTIVE
  REVOKED
}

model Business {
  id                    String                @id @default(uuid())
  clerkOrganizationId   String                @unique
  name                  String
  type                  BusinessType
  ownerUserId           String
  addressLine1          String
  addressLine2          String?
  city                  String
  state                 String
  postalCode            String
  country               String                @default("IN")
  phone                 String
  email                 String
  gstRegistrationStatus GstRegistrationStatus
  gstin                 String?
  financialYearStartMonth Int
  timezone              String                @default("Asia/Kolkata")
  currency              String                @default("INR")
  defaultGstRateBps     Int                   @default(1800)
  lowStockThreshold     Decimal               @default(5.0000) @db.Decimal(18, 4)
  closedThroughPeriodKey String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  owner       User         @relation("BusinessOwner", fields: [ownerUserId], references: [id])
  memberships Membership[]
  auditRecords AuditRecord[]
  outboxEvents OutboxEvent[]
  taxRates     TaxRate[]
  hsnSacCodes  HsnSacCode[]
  accounts     Account[]
  journals     Journal[]
  documents    Document[]
  parties      Party[]
  products     Product[]
  inventoryMovements InventoryMovement[]
  quotations   Quotation[]
  quotationLines QuotationLine[]
  quotationNumberSeries QuotationNumberSeries[]
  salesInvoices SalesInvoice[]
  salesInvoiceLines SalesInvoiceLine[]
  invoiceNumberSeries InvoiceNumberSeries[]
  customerPayments CustomerPayment[]
  customerPaymentAllocations CustomerPaymentAllocation[]
  customerPaymentNumberSeries CustomerPaymentNumberSeries[]
  expenses Expense[]
  expenseNumberSeries ExpenseNumberSeries[]

  @@map("businesses")
}

model Membership {
  id                            String           @id @default(uuid())
  userId                        String
  tenantId                      String
  role                          MembershipRole
  status                        MembershipStatus @default(ACTIVE)
  clerkOrganizationMembershipId String?          @unique
  createdAt                     DateTime         @default(now())
  updatedAt                     DateTime         @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@map("memberships")
}

model AuditRecord {
  id            String   @id @default(uuid())
  tenantId      String
  actorUserId   String
  action        String
  resource      String
  resourceId    String
  metadata      Json     @default("{}")
  correlationId String?
  createdAt     DateTime @default(now())

  business Business @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, resource, resourceId])
  @@index([tenantId, createdAt])
  @@map("audit_records")
}

model OutboxEvent {
  id            String   @id @default(uuid())
  tenantId      String
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  correlationId String?
  processedAt   DateTime?
  createdAt     DateTime @default(now())

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([processedAt, createdAt])
  @@index([tenantId, eventType])
  @@map("outbox_events")
}

model TaxRate {
  id            String    @id @default(uuid())
  tenantId      String
  name          String
  rateBps       Int
  isDefault     Boolean   @default(false)
  effectiveFrom String
  effectiveTo   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isDefault])
  @@index([tenantId, effectiveFrom])
  @@map("tax_rates")
}

model HsnSacCode {
  id            String   @id @default(uuid())
  tenantId      String
  code          String
  description   String
  kind          String
  taxRateBps    Int
  effectiveFrom String
  effectiveTo   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, code])
  @@index([tenantId, effectiveFrom])
  @@map("hsn_sac_codes")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

model Account {
  id            String        @id @default(uuid())
  tenantId      String
  code          String
  name          String
  type          AccountType
  normalBalance NormalBalance
  createdAt     DateTime      @default(now())

  business Business     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines    JournalLine[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("accounts")
}

model Journal {
  id                   String   @id @default(uuid())
  tenantId             String
  accountingDate       String
  periodKey            String
  financialYearKey     String
  sourceType           String
  sourceId             String
  memo                 String?
  reversalOfJournalId  String?
  postedAt             DateTime @default(now())

  business Business     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines    JournalLine[]
  salesInvoices SalesInvoice[]
  customerPayments CustomerPayment[]
  expenses Expense[]

  @@unique([id, tenantId])
  @@unique([tenantId, reversalOfJournalId])
  @@index([tenantId, periodKey])
  @@index([tenantId, sourceType, sourceId])
  @@map("journals")
}

model JournalLine {
  id          String  @id @default(uuid())
  tenantId    String
  journalId   String
  accountId   String
  description String?
  debit       Decimal @db.Decimal(18, 2)
  credit      Decimal @db.Decimal(18, 2)

  journal Journal @relation(fields: [journalId, tenantId], references: [id, tenantId], onDelete: Cascade)
  account Account @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, accountId])
  @@index([journalId])
  @@map("journal_lines")
}

model Document {
  id                 String   @id @default(uuid())
  tenantId           String
  ownerRecordType    String
  ownerRecordId      String
  filename           String
  contentType        String
  sizeBytes          Int
  storageKey         String   @unique
  uploadedByUserId   String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business   Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation("DocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, ownerRecordType, ownerRecordId])
  @@index([tenantId, createdAt])
  @@map("documents")
}

enum PartyKind {
  CUSTOMER
  SUPPLIER
}

enum PartyStatus {
  ACTIVE
  INACTIVE
}

model Party {
  id                    String                @id @default(uuid())
  tenantId              String
  kind                  PartyKind
  name                  String
  phone                 String?
  email                 String?
  billingAddressLine1   String?
  billingAddressLine2   String?
  city                  String?
  state                 String?
  postalCode            String?
  country               String                @default("IN")
  gstRegistrationStatus GstRegistrationStatus @default(NOT_REGISTERED)
  gstin                 String?
  status                PartyStatus           @default(ACTIVE)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  business    Business     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotations  Quotation[]
  salesInvoices SalesInvoice[]
  customerPayments CustomerPayment[]

  @@unique([id, tenantId])
  @@index([tenantId, kind, status])
  @@index([tenantId, name])
  @@map("parties")
}

enum ProductKind {
  PRODUCT
  SERVICE
}

model Product {
  id               String      @id @default(uuid())
  tenantId         String
  kind             ProductKind
  name             String
  sku              String
  unitOfMeasurement String
  sellingPrice     Decimal     @db.Decimal(18, 2)
  purchasePrice    Decimal     @db.Decimal(18, 2)
  hsnSac           String?
  taxRateBps       Int
  category         String?
  tracksInventory  Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  business        Business             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements       InventoryMovement[]
  quotationLines  QuotationLine[]
  salesInvoiceLines SalesInvoiceLine[]

  @@unique([id, tenantId])
  @@unique([tenantId, sku])
  @@index([tenantId, kind])
  @@index([tenantId, name])
  @@map("products")
}

enum InventoryMovementCause {
  OPENING
  ADJUSTMENT
  SALE
  PURCHASE
  RETURN
}

enum InventoryMovementDirection {
  IN
  OUT
}

model InventoryMovement {
  id             String                      @id @default(uuid())
  tenantId       String
  productId      String
  cause          InventoryMovementCause
  direction      InventoryMovementDirection
  quantity       Decimal                     @db.Decimal(18, 4)
  occurredOn     String
  sourceType     String
  sourceId       String
  idempotencyKey String
  reason         String?
  actorUserId    String
  createdAt      DateTime                    @default(now())

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, productId, occurredOn])
  @@index([tenantId, cause])
  @@map("inventory_movements")
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  CANCELLED
  CONVERTED
}

model Quotation {
  id                       String          @id @default(uuid())
  tenantId                 String
  number                   String
  customerId               String
  customerName             String
  status                   QuotationStatus @default(DRAFT)
  issuedOn                 String
  validUntil               String?
  notes                    String?
  placeOfSupplyStateCode   String
  subtotal                 Decimal         @db.Decimal(18, 2)
  discountTotal            Decimal         @db.Decimal(18, 2)
  taxableAmount            Decimal         @db.Decimal(18, 2)
  cgst                     Decimal         @db.Decimal(18, 2)
  sgst                     Decimal         @db.Decimal(18, 2)
  igst                     Decimal         @db.Decimal(18, 2)
  totalTax                 Decimal         @db.Decimal(18, 2)
  grandTotal               Decimal         @db.Decimal(18, 2)
  supplyType               String
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  business Business       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Party          @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  lines    QuotationLine[]
  invoice  SalesInvoice?

  @@unique([id, tenantId])
  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, issuedOn])
  @@map("quotations")
}

model QuotationLine {
  id                 String  @id @default(uuid())
  tenantId           String
  quotationId        String
  sortOrder          Int
  productId          String
  productName        String
  sku                String
  unitOfMeasurement  String
  hsnSac             String?
  taxRateBps         Int
  quantity           Decimal @db.Decimal(18, 4)
  unitPrice          Decimal @db.Decimal(18, 2)
  discount           Decimal @db.Decimal(18, 2)
  lineSubtotal       Decimal @db.Decimal(18, 2)
  taxableAmount      Decimal @db.Decimal(18, 2)
  cgst               Decimal @db.Decimal(18, 2)
  sgst               Decimal @db.Decimal(18, 2)
  igst               Decimal @db.Decimal(18, 2)
  totalTax           Decimal @db.Decimal(18, 2)
  lineTotal          Decimal @db.Decimal(18, 2)
  supplyType         String
  treatment          String

  quotation Quotation @relation(fields: [quotationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  product   Product   @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)
  business  Business  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId, quotationId])
  @@index([quotationId, sortOrder])
  @@map("quotation_lines")
}

model QuotationNumberSeries {
  id                String @id @default(uuid())
  tenantId          String
  financialYearKey  String
  lastNumber        Int

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, financialYearKey])
  @@map("quotation_number_series")
}

enum SalesInvoiceStatus {
  DRAFT
  POSTED
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model SalesInvoice {
  id                       String             @id @default(uuid())
  tenantId                 String
  number                   String
  customerId               String
  customerName             String
  status                   SalesInvoiceStatus @default(DRAFT)
  quotationId              String?
  journalId                String?
  issuedOn                 String
  dueOn                    String?
  notes                    String?
  placeOfSupplyStateCode   String
  subtotal                 Decimal            @db.Decimal(18, 2)
  discountTotal            Decimal            @db.Decimal(18, 2)
  taxableAmount            Decimal            @db.Decimal(18, 2)
  cgst                     Decimal            @db.Decimal(18, 2)
  sgst                     Decimal            @db.Decimal(18, 2)
  igst                     Decimal            @db.Decimal(18, 2)
  totalTax                 Decimal            @db.Decimal(18, 2)
  grandTotal               Decimal            @db.Decimal(18, 2)
  supplyType               String
  postedAt                 DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  business  Business          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Party             @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  quotation Quotation?        @relation(fields: [quotationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  journal   Journal?          @relation(fields: [journalId, tenantId], references: [id, tenantId], onDelete: Restrict)
  lines     SalesInvoiceLine[]
  paymentAllocations CustomerPaymentAllocation[]

  @@unique([id, tenantId])
  @@unique([tenantId, number])
  @@unique([quotationId, tenantId])
  @@unique([journalId, tenantId])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, issuedOn])
  @@map("sales_invoices")
}

model SalesInvoiceLine {
  id                 String  @id @default(uuid())
  tenantId           String
  invoiceId          String
  sortOrder          Int
  productId          String
  productName        String
  sku                String
  unitOfMeasurement  String
  hsnSac             String?
  taxRateBps         Int
  quantity           Decimal @db.Decimal(18, 4)
  unitPrice          Decimal @db.Decimal(18, 2)
  discount           Decimal @db.Decimal(18, 2)
  lineSubtotal       Decimal @db.Decimal(18, 2)
  taxableAmount      Decimal @db.Decimal(18, 2)
  cgst               Decimal @db.Decimal(18, 2)
  sgst               Decimal @db.Decimal(18, 2)
  igst               Decimal @db.Decimal(18, 2)
  totalTax           Decimal @db.Decimal(18, 2)
  lineTotal          Decimal @db.Decimal(18, 2)
  supplyType         String
  treatment          String

  invoice  SalesInvoice @relation(fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  product  Product      @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)
  business Business     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId, invoiceId])
  @@index([invoiceId, sortOrder])
  @@map("sales_invoice_lines")
}

model InvoiceNumberSeries {
  id               String @id @default(uuid())
  tenantId         String
  financialYearKey String
  lastNumber       Int

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, financialYearKey])
  @@map("invoice_number_series")
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  CHEQUE
}

model CustomerPayment {
  id           String        @id @default(uuid())
  tenantId     String
  number       String
  customerId   String
  customerName String
  receivedOn   String
  method       PaymentMethod
  amount       Decimal       @db.Decimal(18, 2)
  reference    String?
  notes        String?
  journalId    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  business     Business                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Party                       @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  journal      Journal                     @relation(fields: [journalId, tenantId], references: [id, tenantId], onDelete: Restrict)
  allocations  CustomerPaymentAllocation[]

  @@unique([id, tenantId])
  @@unique([tenantId, number])
  @@unique([journalId, tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, receivedOn])
  @@map("customer_payments")
}

model CustomerPaymentAllocation {
  id         String  @id @default(uuid())
  tenantId   String
  paymentId  String
  invoiceId  String
  amount     Decimal @db.Decimal(18, 2)

  payment  CustomerPayment @relation(fields: [paymentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  invoice  SalesInvoice    @relation(fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  business Business        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([paymentId, invoiceId])
  @@index([tenantId, invoiceId])
  @@map("customer_payment_allocations")
}

model CustomerPaymentNumberSeries {
  id               String @id @default(uuid())
  tenantId         String
  financialYearKey String
  lastNumber       Int

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, financialYearKey])
  @@map("customer_payment_number_series")
}

enum ExpenseCategory {
  RENT
  UTILITIES
  TRAVEL
  OFFICE
  MARKETING
  PROFESSIONAL_FEES
  REPAIRS
  INSURANCE
  BANK_CHARGES
  MEALS
  SOFTWARE
  OTHER
}

model Expense {
  id             String           @id @default(uuid())
  tenantId       String
  number         String
  category       ExpenseCategory
  incurredOn     String
  method         PaymentMethod
  vendorGstin    String?
  notes          String?
  taxableAmount  Decimal          @db.Decimal(18, 2)
  taxRateBps     Int
  cgst           Decimal          @db.Decimal(18, 2)
  sgst           Decimal          @db.Decimal(18, 2)
  igst           Decimal          @db.Decimal(18, 2)
  totalTax       Decimal          @db.Decimal(18, 2)
  grandTotal     Decimal          @db.Decimal(18, 2)
  supplyType     String
  treatment      String
  journalId      String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journal  Journal  @relation(fields: [journalId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, number])
  @@unique([journalId, tenantId])
  @@index([tenantId, category])
  @@index([tenantId, incurredOn])
  @@map("expenses")
}

model ExpenseNumberSeries {
  id               String @id @default(uuid())
  tenantId         String
  financialYearKey String
  lastNumber       Int

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, financialYearKey])
  @@map("expense_number_series")
}
