generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  clerkUserId String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownedBusinesses Business[]   @relation("BusinessOwner")
  memberships     Membership[]

  @@map("users")
}

enum BusinessType {
  PROPRIETORSHIP
  PARTNERSHIP
  PRIVATE_LIMITED
  LLP
  OTHER
}

enum GstRegistrationStatus {
  NOT_REGISTERED
  REGISTERED
  COMPOSITION
}

enum MembershipRole {
  OWNER
  ADMIN
  STAFF
  ACCOUNTANT
}

enum MembershipStatus {
  ACTIVE
  REVOKED
}

model Business {
  id                    String                @id @default(uuid())
  clerkOrganizationId   String                @unique
  name                  String
  type                  BusinessType
  ownerUserId           String
  addressLine1          String
  addressLine2          String?
  city                  String
  state                 String
  postalCode            String
  country               String                @default("IN")
  phone                 String
  email                 String
  gstRegistrationStatus GstRegistrationStatus
  gstin                 String?
  financialYearStartMonth Int
  timezone              String                @default("Asia/Kolkata")
  currency              String                @default("INR")
  defaultGstRateBps     Int                   @default(1800)
  closedThroughPeriodKey String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  owner       User         @relation("BusinessOwner", fields: [ownerUserId], references: [id])
  memberships Membership[]
  auditRecords AuditRecord[]
  outboxEvents OutboxEvent[]
  taxRates     TaxRate[]
  hsnSacCodes  HsnSacCode[]
  accounts     Account[]
  journals     Journal[]

  @@map("businesses")
}

model Membership {
  id                            String           @id @default(uuid())
  userId                        String
  tenantId                      String
  role                          MembershipRole
  status                        MembershipStatus @default(ACTIVE)
  clerkOrganizationMembershipId String?          @unique
  createdAt                     DateTime         @default(now())
  updatedAt                     DateTime         @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@map("memberships")
}

model AuditRecord {
  id            String   @id @default(uuid())
  tenantId      String
  actorUserId   String
  action        String
  resource      String
  resourceId    String
  metadata      Json     @default("{}")
  correlationId String?
  createdAt     DateTime @default(now())

  business Business @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, resource, resourceId])
  @@index([tenantId, createdAt])
  @@map("audit_records")
}

model OutboxEvent {
  id            String   @id @default(uuid())
  tenantId      String
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  correlationId String?
  processedAt   DateTime?
  createdAt     DateTime @default(now())

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([processedAt, createdAt])
  @@index([tenantId, eventType])
  @@map("outbox_events")
}

model TaxRate {
  id            String    @id @default(uuid())
  tenantId      String
  name          String
  rateBps       Int
  isDefault     Boolean   @default(false)
  effectiveFrom String
  effectiveTo   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isDefault])
  @@index([tenantId, effectiveFrom])
  @@map("tax_rates")
}

model HsnSacCode {
  id            String   @id @default(uuid())
  tenantId      String
  code          String
  description   String
  kind          String
  taxRateBps    Int
  effectiveFrom String
  effectiveTo   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, code])
  @@index([tenantId, effectiveFrom])
  @@map("hsn_sac_codes")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

model Account {
  id            String        @id @default(uuid())
  tenantId      String
  code          String
  name          String
  type          AccountType
  normalBalance NormalBalance
  createdAt     DateTime      @default(now())

  business Business     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines    JournalLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("accounts")
}

model Journal {
  id                   String   @id @default(uuid())
  tenantId             String
  accountingDate       String
  periodKey            String
  financialYearKey     String
  sourceType           String
  sourceId             String
  memo                 String?
  reversalOfJournalId  String?
  postedAt             DateTime @default(now())

  business Business     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines    JournalLine[]

  @@index([tenantId, periodKey])
  @@index([tenantId, sourceType, sourceId])
  @@map("journals")
}

model JournalLine {
  id          String  @id @default(uuid())
  tenantId    String
  journalId   String
  accountId   String
  description String?
  debit       Decimal @db.Decimal(18, 2)
  credit      Decimal @db.Decimal(18, 2)

  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([tenantId, accountId])
  @@index([journalId])
  @@map("journal_lines")
}
